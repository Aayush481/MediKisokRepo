# ==============================================================================
# MediKiosk Production Configuration & Environment Variables
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Database Connection URI (Optional: defaults to in-memory store if unset)
# Example Local: mongodb://localhost:27017/medikiosk
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/medikiosk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medikiosk
MONGODB_DB_NAME=medikiosk

# Google Gemini Multimodal Vision API Key
# Used for Clinical Document Digitization (12-Lead ECGs, X-Rays, Lab Reports, Prescriptions)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
