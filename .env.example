# ==============================================================================
# MediKiosk Production Configuration & Environment Variables
# ==============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=development

# Google Gemini Multimodal Vision API Key
# Used for Clinical Document Digitization (12-Lead ECGs, X-Rays, Lab Reports, Prescriptions)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ==============================================================================
# ABDM (Ayushman Bharat Digital Mission) Configuration
# ==============================================================================
# Gateway Base URL:
# - Sandbox: https://dev.abdm.gov.in
# - Production: https://abdm.gov.in
ABDM_BASE_URL=https://dev.abdm.gov.in

# ABDM Gateway Developer Credentials (from ABDM Developer Portal)
# Obtain from https://sandbox.abdm.gov.in/
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here

# ABDM Consent Manager / Gateway ID: "sbx" for Sandbox
ABDM_CM_ID=sbx

# Healthcare Facility / HIP / HIU Identification
ABDM_FACILITY_ID=IN0100000001

# RSA-OAEP Hash Algorithm for ABDM public key encryption: 'sha256' or 'sha1'
ABDM_OAEP_HASH=sha256

# Optional: Static ABDM Public Certificate PEM override
# If not provided, fetched automatically from ABDM Gateway and cached in memory
# ABDM_PUBLIC_CERT=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----

# ==============================================================================
# Security & DPDP Act 2023 Compliance
# ==============================================================================
# 256-bit Key for At-Rest AES-256-GCM Encryption of sensitive patient data (ABHA, phone)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PATIENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Staff Authentication Secret / JWT Signer for securing internal clinical endpoints
STAFF_AUTH_SECRET=your_hospital_staff_jwt_secret_here

# Optional: Persistent MongoDB Database URI
# If omitted, MediKiosk safely uses its secure in-memory clinical store
MONGODB_URI=mongodb://localhost:27017/medikiosk_db

# ==============================================================================
# Real-Time Event-Driven SMS & TRAI DLT Notification System
# ==============================================================================
# Active SMS Provider Selection: 'FAST2SMS' | 'MSG91' | 'TWILIO' | 'SANDBOX'
SMS_PROVIDER=FAST2SMS

# Redis Connection for BullMQ Job Queue Pipeline & Socket.IO Real-Time Adapter
REDIS_URL=redis://localhost:6379

# TRAI DLT (Telecom Commercial Communications Customer Preference Regulations)
# Registered Principal Entity ID (PE ID) from Vilpower / Jio DLT / Airtel IQ
DLT_ENTITY_ID=1401550000000000001

# Approved 6-character Alpha Header / Sender ID
DLT_SENDER_ID=MDKIOS

# Patient Privacy Preference (DPDP Act 2023): 'FIRST_NAME' | 'FULL_NAME' | 'GENERIC'
PATIENT_NAME_MASKING=FIRST_NAME

# Patient Live Tracking URL Base (Signed short HMAC links)
TRACKING_BASE_URL=http://localhost:3000/q

# Clinic Quiet Hours Window (24h clock, e.g. 21 = 9 PM, 7 = 7 AM)
# Note: Urgent "Your Turn Now" (TOKEN_CALLED) summons bypass quiet hours automatically
QUIET_HOURS_START=21
QUIET_HOURS_END=7

# Webhook Cryptographic Verification Secret (for carrier DLR callbacks)
WEBHOOK_SECRET=your_telecom_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# Telecom Provider Credentials
# ------------------------------------------------------------------------------
# Option A: Fast2SMS (Indian DND & DLT Direct Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: MSG91 (Enterprise Indian Telecom Gateway)
MSG91_AUTH_KEY=your_msg91_authkey_here

# Option C: Twilio (Carrier Fallback / International)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# Neurodevelopmental & ADHD Screening Configuration (Mental Healthcare Act 2017)
# ==============================================================================
# Enable server-side Gemini conversational phrasing & clinical summarization
ENABLE_NEURO_LLM=true

# National Crisis Helpline Overrides (India Tele-MANAS default: 14416)
TELE_MANAS_HELPLINE=14416
EMERGENCY_HELPLINE=112
CHILDLINE_HELPLINE=1098
HOSPITAL_EMERGENCY_EXT=102

# Data retention window for de-identified mental-health screening sessions (in days)
NEURO_SESSION_RETENTION_DAYS=30

